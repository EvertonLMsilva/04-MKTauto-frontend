# URL pública da API NestJS, sem tokens ou credenciais.
# Deixe vazio para trabalhar somente na interface, sem conexão com o backend.
VITE_API_BASE_URL=
# Opcional, apenas no servidor de desenvolvimento (sem prefixo VITE_).
# Aponte para o NestJS local; use a origem do Vite em VITE_API_BASE_URL.
# O proxy preserva Host/Origin e a sessão QC existente. Não contém segredos.
MKTAUTO_API_PROXY_TARGET=
